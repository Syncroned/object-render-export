#!/bin/sh
#
# Reject commits that credit Devin or devin-ai-integration[bot] as a co-author,
# or that contain Devin marketing/attribution lines in the message.

COMMIT_MSG="$1"

if grep -qiE '^co-authored-by:.*devin' "$COMMIT_MSG"; then
    echo "ERROR: Do not list Devin / devin-ai-integration[bot] as a co-author." >&2
    exit 1
fi

if grep -qiE '^generated with.*devin' "$COMMIT_MSG"; then
    echo "ERROR: Do not add 'Generated with Devin' attribution lines." >&2
    exit 1
fi
